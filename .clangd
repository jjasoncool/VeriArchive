CompileFlags:
  CompilationDatabase: build/dev-clangd
  Remove:
    - "-fmodules-ts"
    - "-fmodule-mapper=*"
    - "-fdeps-format=*"
Diagnostics:
  ClangTidy:
    CheckOptions:
      # A (void) cast marks a result discarded on purpose (best-effort cleanup,
      # or a result superseded by an error already returned); the check still
      # reports results dropped without one.
      bugprone-unused-return-value.AllowCastToVoid: true
# On Windows the compile database names the compiler by its target (the
# windows-ucrt64 presets), which is how clangd knows the MinGW headers.
