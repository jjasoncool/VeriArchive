CompileFlags:
  CompilationDatabase: build/dev-clangd
  Remove:
    - "-fmodules-ts"
    - "-fmodule-mapper=*"
    - "-fdeps-format=*"
# Machine-specific settings (a Windows host's MSYS2 target and sysroot, hiding
# Linux-only sources there) belong in the clangd user config, not here; see
# "Editor (clangd)" in README.md.
